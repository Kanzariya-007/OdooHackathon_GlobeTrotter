datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Hashed password
  name      String?
  trips     Trip[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Trip {
  id          String     @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripStops   TripStop[]
  expenses    Expense[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("trips")
}

model City {
  id         Int        @id @default(autoincrement())
  name       String
  country    String
  latitude   Float?
  longitude  Float?
  activities Activity[]
  tripStops  TripStop[]
  createdAt  DateTime   @default(now())

  @@map("cities")
}

model TripStop {
  id             String         @id @default(uuid())
  tripId         String
  trip           Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  cityId         Int
  city           City           @relation(fields: [cityId], references: [id], onDelete: Restrict)
  arrivalDate    DateTime?
  departureDate  DateTime?
  order          Int            // Ordering of stops within the trip
  stopActivities StopActivity[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("trip_stops")
}

model Activity {
  id             String         @id @default(uuid())
  cityId         Int
  city           City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  cost           Decimal?       @db.Decimal(10, 2)
  location       String?
  duration       Int?           // Duration in minutes
  stopActivities StopActivity[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("activities")
}

model StopActivity {
  id          String    @id @default(uuid())
  tripStopId  String
  tripStop    TripStop  @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  activityId  String
  activity    Activity  @relation(fields: [activityId], references: [id], onDelete: Restrict)
  order       Int       // Order of the activity within the trip stop
  plannedTime DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tripStopId, activityId])
  @@map("stop_activities")
}

model Expense {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title     String
  amount    Decimal  @db.Decimal(10, 2)
  currency  String   @default("USD")
  category  String?  // Flight, Food, Hotel, Activity, Transit, etc.
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("expenses")
}
